SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The site's public address, used for links in password-reset emails (e.g. https://rmr-finance.vercel.app).
SITE_URL=http://localhost:3000

# View mode (/view): one button, no key; it shows the Research ledger only (enforced by the database).
# The shared read-only Supabase user. No built-in default: without a password (>= 16 chars) view mode is off.
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=a-long-random-password
