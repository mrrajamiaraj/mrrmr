SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The site's public address, used for links in password-reset emails (e.g. https://rmr-finance.vercel.app).
SITE_URL=http://localhost:3000

# View mode (/view): the shared read-only Supabase user, and the password visitors type.
# Set all three in production: the built-in fallbacks are in the source code.
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=a-long-random-password
VIEW_PASSCODE=use-a-long-passphrase-not-a-word
